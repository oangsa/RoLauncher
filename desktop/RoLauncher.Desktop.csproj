<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RoLauncher.Desktop</RootNamespace>
    <ApplicationIcon>../assets/RoLauncher.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>false</NuGetAudit>
    <DefineConstants Condition="'$(UiSmoke)' == 'true'">$(DefineConstants);UI_SMOKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>
  <ItemGroup><Content Include="CHANGELOG.txt" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <Content Include="../assets/fonts/OpenSans.ttf" Link="Assets/Fonts/OpenSans.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/fonts/OpenSans-Regular.ttf" Link="Assets/Fonts/OpenSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/RoLauncher.ico" Link="RoLauncher.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../scripts/apply-update.ps1" LogicalName="RoLauncher.ApplyUpdate.ps1" />
  </ItemGroup>
  <Target Name="PublishXamlResources" BeforeTargets="ComputeFilesToPublish" AfterTargets="Build">
    <ItemGroup><ResolvedFileToPublish Include="$(TargetDir)$(TargetName).pri"><RelativePath>$(TargetName).pri</RelativePath><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></ResolvedFileToPublish></ItemGroup>
  </Target>
  <ItemGroup><EmbeddedResource Include="CHANGELOG.txt" LogicalName="RoLauncher.Changelog" /></ItemGroup>
</Project>
