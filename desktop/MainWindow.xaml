<Window x:Class="RoLauncher.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:RoLauncher.Desktop">
  <Grid x:Name="Root" Background="{StaticResource WorkspaceBrush}" RequestedTheme="Light">
    <Grid.Resources>
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#18181B"/>
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#323235"/>
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#454548"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#18181B"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#323235"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#454548"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="White"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FAFAFA"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#E4E4E7"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#18181B"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#18181B"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#18181B"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#D4D4D8"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#D4D4D8"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#D4D4D8"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#18181B"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#323235"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#454548"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#18181B"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#323235"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#454548"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="#18181B"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="#323235"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="#454548"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="#18181B"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" Color="#323235"/>
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" Color="#454548"/>
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#18181B"/>
      <SolidColorBrush x:Key="PasswordBoxBorderBrushFocused" Color="#18181B"/>
    </Grid.Resources>
    <Grid.KeyboardAccelerators><KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAll_Invoked"/></Grid.KeyboardAccelerators>
    <Grid.ColumnDefinitions><ColumnDefinition Width="152"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Column="1" Margin="28,22,28,18" ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock Text="RoLauncher" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
        <TextBlock Text="Your accounts. One workspace." Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
      <TextBlock x:Name="VersionLabel" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
      <Button Grid.Column="2" Click="Changelog_Click" VerticalAlignment="Center" ToolTipService.ToolTip="What’s new" AutomationProperties.Name="What’s new"><FontIcon Glyph="&#xE946;"/></Button>
    </Grid>
    <Border Grid.RowSpan="4" Background="#EEEEF0" Padding="12,24" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <StackPanel Spacing="8">
        <TextBlock Text="WORKSPACE" Style="{StaticResource Caption}" Margin="8,0,0,16"/>
        <ToggleButton x:Name="AccountsTab" Content="Accounts" Tag="0" IsChecked="True" Click="Tab_Click" HorizontalAlignment="Stretch" Padding="12,12"/>
        <ToggleButton x:Name="GamesTab" Content="Games" Tag="4" Click="Tab_Click" HorizontalAlignment="Stretch" Padding="12,12"/>
        <ToggleButton x:Name="RecoveryTab" Content="Dashboard" Tag="3" Click="Tab_Click" HorizontalAlignment="Stretch" Padding="12,12"/>
        <ToggleButton x:Name="SettingsTab" Content="Settings" Tag="1" Click="Tab_Click" HorizontalAlignment="Stretch" Padding="12,12"/>
      </StackPanel>
    </Border>
    <InfoBar x:Name="UpdateNotice" Grid.Column="1" Grid.Row="2" Margin="28,0,28,18" Visibility="Collapsed" IsOpen="False" IsClosable="False" Severity="Informational">
      <InfoBar.ActionButton><Button x:Name="UpdateNoticeButton" Content="Download" Click="UpdateAction_Click"/></InfoBar.ActionButton>
    </InfoBar>
    <ScrollViewer x:Name="PageScroll" Grid.Column="1" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="28,0,28,8">
      <Grid MinWidth="740">
        <StackPanel x:Name="AccountsPage" Spacing="16">
          <Border Style="{StaticResource Card}">
            <StackPanel Spacing="14">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Add an account" Style="{StaticResource SectionTitle}"/>
                <TextBlock Grid.Column="1" Text="Sign in with your browser or import a session cookie." Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              </Grid>
              <Button x:Name="LoginButton" Content="Browser sign-in" Style="{StaticResource AccentButtonStyle}" Click="Login_Click" HorizontalAlignment="Left" Padding="18,9" CornerRadius="8"/>
              <Expander Header="Import an existing session" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <PasswordBox x:Name="CookieInput" PlaceholderText="Paste a session cookie" PasswordRevealMode="Hidden" MaxLength="16384" AutomationProperties.Name="Session cookie"/>
                  <Button x:Name="ImportButton" Grid.Column="1" Content="Import cookie" Click="Import_Click"/>
                  <Button x:Name="FileButton" Grid.Column="2" Content="Import file…" Click="File_Click"/>
                </Grid>
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel Spacing="16">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4"><TextBlock Text="Accounts" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="AccountCount" Text="0 accounts" Style="{StaticResource Caption}"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button x:Name="StartButton" Content="Start" Tag="start" Click="Action_Click" Style="{StaticResource AccentButtonStyle}" Padding="18,9" CornerRadius="8" IsEnabled="False"/>
                  <Button x:Name="StopButton" Content="Stop" Tag="stop" Click="Action_Click" IsEnabled="False"/>
                  <Button Content="More"><Button.Flyout><MenuFlyout>
                    <MenuFlyoutItem x:Name="RestartButton" Text="Restart selected" Tag="restart" Click="Action_Click" IsEnabled="False"/>
                    <MenuFlyoutItem x:Name="RemoveButton" Text="Remove selected" Tag="remove" Click="Action_Click" IsEnabled="False"/>
                    <MenuFlyoutItem Text="Retry selected now" Tag="retry" Click="Action_Click"/>
                    <MenuFlyoutItem Text="Sign in again" Click="RepairSelected_Click"/>
                  </MenuFlyout></Button.Flyout></Button>
                </StackPanel>
              </Grid>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="NameSearch" PlaceholderText="Search alias or username…" TextChanged="Filters_Changed" AutomationProperties.Name="Search accounts by name"/>
                <ComboBox x:Name="StatusFilter" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" SelectionChanged="Filters_Changed" AutomationProperties.Name="Filter accounts by status">
                  <ComboBoxItem Content="All statuses" Tag=""/><ComboBoxItem Content="Running" Tag="running"/><ComboBoxItem Content="Stopped" Tag="stopped"/>
                  <ComboBoxItem Content="Queued" Tag="queued"/><ComboBoxItem Content="Launching" Tag="launching"/><ComboBoxItem Content="Reconnecting" Tag="reconnecting"/>
                  <ComboBoxItem Content="Backoff" Tag="backoff"/><ComboBoxItem Content="Needs attention" Tag="needs_attention"/><ComboBoxItem Content="Unknown" Tag="unknown"/>
                </ComboBox>
                <ComboBox x:Name="RejoinFilter" Grid.Column="2" SelectedIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" SelectionChanged="Filters_Changed" AutomationProperties.Name="Filter accounts by automatic rejoin">
                  <ComboBoxItem Content="All rejoin settings" Tag=""/><ComboBoxItem Content="Rejoin on" Tag="on"/><ComboBoxItem Content="Rejoin off" Tag="off"/>
                </ComboBox>
                <Button Grid.Column="3" Content="Clear" Click="ClearFilters_Click" ToolTipService.ToolTip="Clear search and filters"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="GroupFilter" MinWidth="160" VerticalAlignment="Stretch" VerticalContentAlignment="Center" PlaceholderText="All groups" SelectionChanged="Filters_Changed" AutomationProperties.Name="Filter accounts by group"/>
                <Button x:Name="BulkEditButton" Content="Edit selected" Click="BulkEdit_Click" IsEnabled="False"/>
                <Button Content="Selection"><Button.Flyout><MenuFlyout>
                  <MenuFlyoutItem Text="Select visible · Ctrl+A" Click="SelectVisible_Click"/>
                  <MenuFlyoutItem Text="Select all accounts" Click="SelectAllSaved_Click"/>
                  <MenuFlyoutItem Text="Edit all accounts" Click="EditAll_Click"/>
                </MenuFlyout></Button.Flyout></Button>
              </StackPanel>
              <Grid Background="#F5F5F6" Padding="12,10" CornerRadius="6" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="52"/><ColumnDefinition Width="118"/><ColumnDefinition Width="88"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <TextBlock Text="Account" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="PID" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource Caption}"/><TextBlock Grid.Column="3" Text="Target" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Column="4" Text="Failures" Style="{StaticResource Caption}"/><TextBlock Grid.Column="5" Text="Rejoin" Style="{StaticResource Caption}"/><TextBlock Grid.Column="6" Text="Last error" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Column="7" Text="Actions" Style="{StaticResource Caption}"/>
              </Grid>
              <Grid>
                <ListView x:Name="AccountList" MinHeight="170" MaxHeight="340" SelectionMode="Extended" SelectionChanged="AccountList_SelectionChanged" IsItemClickEnabled="False" AutomationProperties.Name="Accounts, use Control or Shift to select multiple">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="8"/></Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Padding="12,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="52"/><ColumnDefinition Width="118"/><ColumnDefinition Width="88"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3"><TextBlock Text="{Binding Alias}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Username}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Group}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Pid}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        <Border Grid.Column="2" Background="{Binding Account.Status, Converter={StaticResource StatusBackground}}" CornerRadius="6" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Status}" Foreground="{Binding Account.Status, Converter={StaticResource StatusForeground}}" FontSize="12"/>
                        </Border>
                        <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding Destination}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DestinationKind}" Style="{StaticResource Caption}"/></StackPanel>
                        <TextBlock Grid.Column="4" Text="{Binding Failures}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="5" Text="{Binding Rejoin}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="6" Text="{Binding Error}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Error}"/>
                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Button x:Name="RowDetailsButton" Width="38" Height="38" Padding="0" Background="Transparent" BorderThickness="0" Tag="{Binding Id}" Click="RowDetails_Click" ToolTipService.ToolTip="View / edit account" AutomationProperties.Name="View or edit account details"><FontIcon Glyph="&#xE70F;" FontSize="16"/></Button>
                          <Button Width="38" Height="38" Padding="0" Background="Transparent" BorderThickness="0" Tag="{Binding Id}" Click="RowDelete_Click" ToolTipService.ToolTip="Delete account" AutomationProperties.Name="Delete account"><FontIcon Glyph="&#xE74D;" FontSize="16"/></Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                  <FontIcon Glyph="&#xE77B;" FontSize="28" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock x:Name="EmptyTitle" Text="No accounts yet" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="EmptyHint" Text="Add your first account above to get started." Style="{StaticResource Caption}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="RecoveryPage" Spacing="16" Visibility="Collapsed">
          <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
            <TextBlock Text="Dashboard" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="DashboardCounts" FontSize="22" TextWrapping="Wrap"/>
            <TextBlock Text="Launch and rejoin events · last 24 hours" Style="{StaticResource Caption}"/>
            <StackPanel x:Name="TrendBars" Orientation="Horizontal" Spacing="8" Height="110"/>
            <TextBlock x:Name="TrendSummary" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="CompatibilityText" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
            <ItemsControl x:Name="RecoveryList"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Padding="0,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><StackPanel Spacing="6">
                <TextBlock Text="{Binding Alias}" FontWeight="SemiBold"/><TextBlock Text="{Binding Username}" Style="{StaticResource Caption}"/>
                <StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Group}" TextWrapping="Wrap" MaxWidth="220"/><TextBlock Text="{Binding Fallback}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                <TextBlock Text="{Binding RecoveryAttempts}" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding Recovery}" TextWrapping="Wrap"/><TextBlock Text="{Binding Retry}" Style="{StaticResource Caption}"/>

              </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
            <TextBlock Text="Activity history" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Latest 1,000 events · retained across restarts" Style="{StaticResource Caption}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="HistoryAccount" MinWidth="200" PlaceholderText="All accounts" SelectionChanged="History_Changed"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="HistoryPrevious" Content="Newer" Tag="-1" Click="HistoryPage_Click"/><TextBlock x:Name="HistoryPageSummary" VerticalAlignment="Center"/><Button x:Name="HistoryNext" Content="Older" Tag="1" Click="HistoryPage_Click"/></StackPanel>
            <ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}">
            <StackPanel Spacing="14"><TextBlock Text="Recent activity" Style="{StaticResource SectionTitle}"/><TextBlock Text="This session · newest first · includes alerts while Discord is off" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="ActivityEmpty" Text="No activity yet." Foreground="{StaticResource MutedBrush}"/>
              <ItemsControl x:Name="ActivityList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Account}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding Timestamp}" Style="{StaticResource Caption}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="SettingsPage" Spacing="16" Visibility="Collapsed">
          <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Window" Style="{StaticResource SectionTitle}"/>
            <ComboBox x:Name="CloseBehavior" Header="When I close RoLauncher" HorizontalAlignment="Stretch" SelectionChanged="CloseBehavior_Changed"><ComboBoxItem Content="Minimize to tray"/><ComboBoxItem Content="Close completely"/></ComboBox>
            <TextBlock Text="Closing completely stops automatic rejoin and leaves game clients open. Without a tray host, minimize keeps the Linux window accessible." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><Expander Header="Legacy account presets" HorizontalAlignment="Stretch"><StackPanel Spacing="12">
            <TextBlock Text="Account presets" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Use Edit selected to assign a group or update account settings together. Save a profile to capture each selected account’s current configuration." TextWrapping="Wrap" Style="{StaticResource Caption}"/>
            <Button Content="Edit selected accounts" Click="BulkEdit_Click" HorizontalAlignment="Left"/>
            <TextBox x:Name="ProfileName" Header="Profile name" MaxLength="100"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save selected as profile" Click="SaveProfile_Click"/><Button Content="Export profiles" Click="ExportProfiles_Click"/><Button Content="Import profiles" Click="ImportProfiles_Click"/></StackPanel>
            <ComboBox x:Name="ProfilePicker" HorizontalAlignment="Stretch" PlaceholderText="Choose a saved profile"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Review / launch" Click="LaunchProfile_Click"/><Button Content="Apply settings" Click="ApplyProfile_Click"/><Button Content="Replace with selected" Click="ReplaceProfile_Click"/><Button Content="Delete profile" Click="DeleteProfile_Click"/></StackPanel>
          </StackPanel></Expander></Border>
          <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
            <TextBlock Text="Backup and restore" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="BackupDescription" Text="Ten encrypted local backups are kept. Restore works for this Windows user and leaves restored accounts stopped. Stop all accounts before restoring." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <ComboBox x:Name="BackupPicker" HorizontalAlignment="Stretch" PlaceholderText="Choose a local backup"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Create backup" Click="Backup_Click"/><Button Content="Restore backup" Click="Restore_Click"/></StackPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}">
            <StackPanel Spacing="14">
              <TextBlock Text="Auto Rejoin" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="SelectionSummary" Text="Select accounts on the Accounts page to change their settings." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="RejoinCheck" Content="Automatic rejoin" IsThreeState="True" IsEnabled="False" Click="Rejoin_Click"/></Grid>
              <TextBlock Text="Waits 30 seconds for reconnection, then retries with backoff. Turning this off keeps the client open. Changes save immediately." Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel Spacing="14">
              <TextBlock Text="Discord notifications" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Create a channel webhook in Discord → Integrations. These settings apply to all accounts." Style="{StaticResource Caption}"/>
              <StackPanel Orientation="Horizontal" Spacing="24"><CheckBox x:Name="DiscordEnabled" Content="Enable notifications" Click="DiscordPreference_Click"/><CheckBox x:Name="DiscordRecovery" Content="Also notify for rejoin and back online" Click="DiscordPreference_Click"/></StackPanel>
              <PasswordBox x:Name="WebhookInput" Header="Webhook URL · hidden" PlaceholderText="Leave blank to keep the saved webhook" PasswordRevealMode="Hidden" MaxLength="512"/>
              <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save webhook" Click="WebhookSave_Click" Style="{StaticResource AccentButtonStyle}" Padding="18,9" CornerRadius="8"/><Button Content="Send test" Click="WebhookTest_Click"/><Button Content="Remove webhook" Click="WebhookRemove_Click"/></StackPanel>
              <TextBlock x:Name="DiscordStatus" Text="No webhook configured." Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}"><Expander Header="Support and integrations" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><Button Content="Export support report" Click="ExportDiagnostics_Click"/><Button Content="API token" Click="Token_Click"/></StackPanel></Expander></Border>
          <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
            <CheckBox x:Name="IncludeBetaUpdates" Content="Include beta updates" Checked="BetaUpdates_Changed" Unchecked="BetaUpdates_Changed"/>
            <TextBlock Text="Beta versions include features that are still being tested. Turn this on to receive stable and beta releases." Style="{StaticResource Caption}"/>
            <TextBlock Text="RoLauncher checks GitHub automatically on startup and every six hours. Download an available update, then choose Relaunch to install it. Your accounts and settings are backed up, and Roblox clients stay open." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CheckUpdatesButton" Content="Check updates" Click="CheckUpdates_Click"/><Button x:Name="UpdateDownloadButton" Content="Download" Click="UpdateAction_Click" IsEnabled="False"/><Button x:Name="UpdateReleaseNotesButton" Content="Release notes" Click="OpenUpdate_Click" IsEnabled="False"/></StackPanel>
            <TextBlock x:Name="UpdateStatus" Text="Updates are checked automatically." TextWrapping="Wrap" Style="{StaticResource Caption}"/>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="GamesPage" Spacing="16" Visibility="Collapsed">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4"><TextBlock Text="Saved games" Style="{StaticResource SectionTitle}"/><TextBlock Text="Save a destination once, then choose it in account settings." Style="{StaticResource Caption}"/></StackPanel>
            <Button Grid.Column="1" Content="Add game" Click="AddGame_Click" Style="{StaticResource AccentButtonStyle}"/>
          </Grid>
          <TextBlock x:Name="GamesEmpty" Text="No saved games yet. Add a game to get started." Style="{StaticResource Caption}"/>
          <ItemsControl x:Name="GameCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:GameCardPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource Card}" Width="270" Margin="0,0,12,12"><StackPanel Spacing="12">
                <Grid Height="150" Background="#EEEEF0" CornerRadius="8"><TextBlock Text="Game" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Caption}"/><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Grid>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding GameName}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Destination}" Style="{StaticResource Caption}"/>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Edit" Tag="{Binding Id}" Click="EditGame_Click"/><Button Content="Delete" Tag="{Binding Id}" Click="DeleteGame_Click"/></StackPanel>
              </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <InfoBar x:Name="Feedback" Grid.Column="1" Grid.RowSpan="3" IsOpen="False" IsClosable="True" Closed="Feedback_Closed"
             HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="640" Margin="28,12,28,0"
             CornerRadius="10" Severity="Informational" AutomationProperties.LiveSetting="Polite"/>
    <ContentDialog x:Name="AccountDialog" Title="Account details" PrimaryButtonText="Save changes" CloseButtonText="Cancel" DefaultButton="Primary" RequestedTheme="Light" PrimaryButtonClick="AccountDialog_Save" Closing="AccountDialog_Closing">
      <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">640</x:Double></ContentDialog.Resources>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="DialogFields" Spacing="16">
          <StackPanel Spacing="4"><TextBlock Text="{Binding Username}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Id}" Style="{StaticResource Caption}"/></StackPanel>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4"><TextBlock Text="Status" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Status}"/></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="PID" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Pid}"/></StackPanel>
            <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Failures" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Failures}"/></StackPanel>
          </Grid>
          <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          <TextBox x:Name="AliasInput" Header="Alias" PlaceholderText="Account alias"/>
          <ComboBox x:Name="DialogGame" Header="Saved game" HorizontalAlignment="Stretch" PlaceholderText="Custom destination" SelectionChanged="DialogGame_Changed"/>
          <TextBox x:Name="PlaceInput" Header="Place ID" PlaceholderText="e.g. 1818"/>
          <TextBox x:Name="JobInput" Header="Job ID · optional" PlaceholderText="Server job ID"/>
          <TextBox x:Name="PrivateInput" Header="Private server link · optional" PlaceholderText="https://www.roblox.com/…" MaxLength="2048"/>
          <CheckBox x:Name="DialogRejoin" Content="Automatic rejoin"/>
          <TextBox x:Name="DialogGroup" Header="Group · optional" MaxLength="100"/>
          <ComboBox x:Name="DialogFallback" Header="If the destination is unavailable" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Allow public fallback"/><ComboBoxItem Content="Stay on this destination"/><ComboBoxItem Content="Pause and notify"/>
          </ComboBox>
          <CheckBox x:Name="DialogClearTarget" Content="Clear the saved destination"/>
          <TextBlock Text="Changes apply when you save. Updated destinations are used on the next launch." Style="{StaticResource Caption}"/>
          <InfoBar x:Name="EditorError" IsOpen="False" IsClosable="False" Severity="Error"/>
        </StackPanel>
      </ScrollViewer>
    </ContentDialog>
  </Grid>
</Window>
