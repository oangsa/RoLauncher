<Application x:Class="RoLauncher.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:RoLauncher.Desktop">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#18181B</Color>
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#18181B"/>
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#323235"/>
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#454548"/>
          <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#18181B"/>
          <SolidColorBrush x:Key="AccentButtonBackground" Color="#18181B"/>
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#323235"/>
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#454548"/>
          <SolidColorBrush x:Key="AccentButtonForeground" Color="White"/>
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
          <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White"/>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#18181B"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <Thickness x:Key="InfoBarActionHorizontalOrientationMargin">16,4,0,4</Thickness>
      <local:StatusConverter x:Key="StatusBackground" Background="True"/>
      <local:StatusConverter x:Key="StatusForeground"/>
      <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
      <SolidColorBrush x:Key="WorkspaceBrush" Color="#F7F7F8"/>
      <SolidColorBrush x:Key="CardBrush" Color="White"/>
      <SolidColorBrush x:Key="LineBrush" Color="#E4E4E7"/>
      <SolidColorBrush x:Key="InkBrush" Color="#18181B"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#71717A"/>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
      </Style>
      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      </Style>
      <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style TargetType="Button">
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="CornerRadius" Value="8"/>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,9"/>
      </Style>
      <Style TargetType="PasswordBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,9"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
