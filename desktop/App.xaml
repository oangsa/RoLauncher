<Application x:Class="RoLauncher.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:RoLauncher.Desktop">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C"/>
          <SolidColorBrush x:Key="WorkspaceBrush" Color="#B8F4F6FA"/>
          <SolidColorBrush x:Key="CardBrush" Color="#F2FFFFFF"/>
          <SolidColorBrush x:Key="LineBrush" Color="#220F284A"/>
          <SolidColorBrush x:Key="InkBrush" Color="#18181B"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#71717A"/>
          <AcrylicBrush x:Key="SidebarBrush" TintColor="#F2F6FC" TintOpacity="0.72" TintLuminosityOpacity="0.8" FallbackColor="#EEF2F8"/>
          <SolidColorBrush x:Key="GlassEdgeBrush" Color="#80FFFFFF"/>
          <SolidColorBrush x:Key="NavigationSelectionBrush" Color="#D4DFEBFF"/>
          <SolidColorBrush x:Key="NavigationMarkerBrush" Color="#2563EB"/>
          <Color x:Key="NavigationHoverColor">#100B2445</Color>
          <LinearGradientBrush x:Key="GlassAmbientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#247EA9F5" Offset="0"/><GradientStop Color="#007EA9F5" Offset="0.65"/><GradientStop Color="#1452AAAE" Offset="1"/>
          </LinearGradientBrush>
          <SolidColorBrush x:Key="TableHeaderBrush" Color="#F5F5F6"/>
          <SolidColorBrush x:Key="AccentButtonBackground" Color="#18181B"/>
          <SolidColorBrush x:Key="AccentButtonForeground" Color="White"/>
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#18181B"/>
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#18181B"/>
          <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#18181B"/>
          <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#18181B"/>
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
          <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DangerBrush" Color="#FF9494"/>
          <SolidColorBrush x:Key="WorkspaceBrush" Color="#A8181D29"/>
          <SolidColorBrush x:Key="CardBrush" Color="#EE242B38"/>
          <SolidColorBrush x:Key="LineBrush" Color="#28C3D5F4"/>
          <SolidColorBrush x:Key="InkBrush" Color="#FAFAFA"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#A1A1AA"/>
          <AcrylicBrush x:Key="SidebarBrush" TintColor="#1D2638" TintOpacity="0.72" TintLuminosityOpacity="0.8" FallbackColor="#202938"/>
          <SolidColorBrush x:Key="GlassEdgeBrush" Color="#30C9DDFF"/>
          <SolidColorBrush x:Key="NavigationSelectionBrush" Color="#C03B506F"/>
          <SolidColorBrush x:Key="NavigationMarkerBrush" Color="#AFCBFF"/>
          <Color x:Key="NavigationHoverColor">#18FFFFFF</Color>
          <LinearGradientBrush x:Key="GlassAmbientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#304F81DE" Offset="0"/><GradientStop Color="#007EA9F5" Offset="0.65"/><GradientStop Color="#1452AAAE" Offset="1"/>
          </LinearGradientBrush>
          <SolidColorBrush x:Key="TableHeaderBrush" Color="#303034"/>
          <SolidColorBrush x:Key="AccentButtonBackground" Color="#D4D4D8"/>
          <SolidColorBrush x:Key="AccentButtonForeground" Color="#18181B"/>
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#D4D4D8"/>
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D4D4D8"/>
          <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#D4D4D8"/>
          <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#D4D4D8"/>
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#18181B"/>
          <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#18181B"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="WorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="LineBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="SidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="TableHeaderBrush" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="GlassEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="NavigationSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
          <SolidColorBrush x:Key="NavigationMarkerBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
          <Color x:Key="NavigationHoverColor">#00000000</Color>
          <SolidColorBrush x:Key="GlassAmbientBrush" Color="Transparent"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <Thickness x:Key="InfoBarActionHorizontalOrientationMargin">16,4,0,4</Thickness>
      <local:StatusConverter x:Key="StatusBackground" Background="True"/>
      <local:StatusConverter x:Key="StatusForeground"/>
      <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
      </Style>
      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
      </Style>
      <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="8"/>
      </Style>
      <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="8"/>
      </Style>
      <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DangerBrush}"/>
      </Style>
      <Style TargetType="Button">
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="CornerRadius" Value="8"/>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,9"/>
      </Style>
      <Style TargetType="PasswordBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,9"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
